#!/usr/bin/env bash
# Runs the quality gates CLAUDE.md declares, because declaring them is not
# enough: a gate that runs only when someone remembers is a gate that skips.
#
# Enabled with `git config core.hooksPath .githooks`, which is why this lives in
# the repository rather than in `.git/hooks` — a hook nobody else receives
# protects one machine.
#
# `--no-verify` skips it. That is deliberate and not a hole: the point is that
# skipping becomes a decision someone typed, rather than something that happened.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
run() { # $1 = name, rest = command
  local name="$1"; shift
  if out=$("$@" 2>&1); then
    printf '\033[32m✓\033[0m %s\n' "$name"
  else
    printf '\033[31m✗\033[0m %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/    /'
    fail=1
  fi
}

run "plugin schema"  claude plugin validate . --strict
run "guard corpus"   ./hooks/bash-guard.test.sh
# The Agent guard's whole pass — corpus, probes and mutants — takes about two
# seconds, so it needs no trigger.
run "agent guard"    ./hooks/agent-guard.test.sh --mutate
# The process gate and the waiver that is its only supported escape. Same cost
# as the pass above, so the same lack of a trigger. The pair is inseparable: a
# gate whose escape stops recording turns every skip back into a silence
# indistinguishable from having followed the protocol.
run "process guard"  ./hooks/process-guard.test.sh --mutate
run "waiver"         ./hooks/waiver.test.sh
run "call log"       ./hooks/call-log.test.sh
# The three hooks that emit rather than decide. Their failure is silence, so
# nothing but these would report it.
run "canon loader"   ./hooks/canon-loader.test.sh
run "rules loader"   ./hooks/rules-loader.test.sh
run "handoff prompt" ./hooks/handoff-prompt.test.sh
# The deny-list reporter's failure is silence too: a detector that stops
# noticing drift looks identical to a project with nothing missing.
run "permissions check" ./hooks/permissions-check.test.sh
run "library claims" ./skills/sharpen/check-claims.sh

# The mutation pass takes minutes, so it runs only when the thing it pins is
# being changed.
if git diff --cached --name-only | grep -qE '^hooks/(bash-guard\.sh|bash-guard\.test\.sh|cases\.tsv|guard-test-lib\.sh)$'; then
  printf '  … guard changed, running the mutation pass (minutes)\n'
  run "guard mutation" ./hooks/bash-guard.test.sh --mutate
fi

if [ "$fail" -ne 0 ]; then
  printf '\nCommit refused: a declared gate is red. Fix it, or `git commit --no-verify` and say why.\n'
  exit 1
fi
