{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Agent|Skill|Edit|Write|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/call-log.sh\""
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/work-archive.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/canon-loader.sh\"",
            "timeout": 5,
            "statusMessage": "Loading the canon..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/permissions-check.sh\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5,
            "statusMessage": "Checking the deny-list against this project..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/handoff-prompt.sh\"",
            "timeout": 10,
            "statusMessage": "Checking whether this session has residue to hand off..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Skill|Edit|Write|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rules-loader.sh\"",
            "timeout": 5,
            "statusMessage": "Loading the rules for this scope..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/call-log.sh\"",
            "timeout": 5,
            "statusMessage": "Recording the call..."
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking command against security policy..."
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/process-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the process gates and the settings files..."
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agent-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the agent spawn returns its report..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/canon-loader.sh\"",
            "timeout": 5,
            "statusMessage": "Loading the canon for the subagent..."
          }
        ]
      }
    ]
  }
}
