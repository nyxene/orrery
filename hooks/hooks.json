{
  "hooks": {
    "PostToolUse": [
      {
        "_comment": "The second half of the call log. PostToolUse fires only when a tool succeeds and carries the same tool_use_id as its PreToolUse event, so a `call` line with no matching `ran` line is a call that did not run — guard, classifier, person or interrupt, all by the same absence. Same matcher as the PreToolUse registration on purpose: a pair can only be formed if both halves watch the same tools. This costs one hook invocation per successful call, which is the price of the log meaning anything about outcomes; before it, a refused call and a completed one were byte-identical rows.",
        "matcher": "^(Agent|Edit|Write|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/call-log.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/canon-loader.sh\"",
            "timeout": 5,
            "statusMessage": "Loading the canon..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/permissions-check.sh\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 5,
            "statusMessage": "Checking the deny-list against this project..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/handoff-prompt.sh\"",
            "timeout": 10,
            "statusMessage": "Checking whether this session has residue to hand off..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Edit|Write|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rules-loader.sh\"",
            "timeout": 5,
            "statusMessage": "Loading the rules for this scope..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/call-log.sh\"",
            "timeout": 5,
            "statusMessage": "Recording the call..."
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking command against security policy..."
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agent-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the agent spawn returns its report..."
          }
        ]
      }
    ]
  }
}
