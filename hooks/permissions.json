{
  "_comment": "Reusable deny-list. Merge into a project's .claude/settings.json permissions block.",
  "permissions": {
    "deny": [
      "Bash(cd /etc*)",
      "Bash(cd /System*)",
      "Bash(cd /Library*)",
      "Bash(cd /sbin*)",
      "Bash(cd /private/etc*)",
      "Bash(cd /var/root*)",
      "Bash(cd /var/db*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git checkout .*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git restore --staged --worktree .*)",
      "Bash(git branch -D*)",
      "Read(//etc/**)",
      "Read(//bin/**)",
      "Read(//private/etc/**)",
      "Read(//var/root/**)",
      "Read(//var/db/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Edit(//etc/**)",
      "Edit(//System/**)",
      "Edit(//Library/**)",
      "Edit(//usr/**)",
      "Edit(//sbin/**)",
      "Edit(//bin/**)",
      "Edit(//private/etc/**)",
      "Edit(//var/root/**)",
      "Edit(//var/db/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/**)",
      "Write(//etc/**)",
      "Write(//System/**)",
      "Write(//Library/**)",
      "Write(//usr/**)",
      "Write(//sbin/**)",
      "Write(//bin/**)",
      "Write(//private/etc/**)",
      "Write(//var/root/**)",
      "Write(//var/db/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.gnupg/**)",
      "Write(~/.kube/**)",
      "Write(~/.docker/**)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.development.local)",
      "Read(**/.env.development.local)",
      "Read(.env.test)",
      "Read(**/.env.test)",
      "Read(.env.test.local)",
      "Read(**/.env.test.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.production.local)",
      "Read(**/.env.production.local)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Read(.envrc)",
      "Read(**/.envrc)",
      "Read(**/credentials.json)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)"
    ]
  }
}
